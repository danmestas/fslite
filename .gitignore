# Build artefacts
/fslite
/bin/
*.fossil
*.test

# Demo / temp working dirs
demo-data/

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp

# Anything starting with a dot at repo root is ignored by default;
# track only the explicit allowlist below. Keeps contributor-local
# tooling state out of commits regardless of which tools they run.
/.*
!/.gitignore
!/.github/

# Agent tooling scratch (never belongs in the repo)
.agent-config/
